{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Career Agent Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/1c/test_career_agent_returns_results.py",
                "--asyncio-mode=auto",
                "-s",
                "-v"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}